{
  "name": "node-ffprobe",
  "version": "0.1.0",
  "description": "A lightweight Node.js wrapper for `ffprobe` that returns parsed media metadata as JSON, with TypeScript types",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phygon/node-ffprobe.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {},
  "devDependencies": {
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node26": "^26.0.1",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
